# GABi's [GABi] notes go to stdout; Snakemake's own logger goes to stderr.
# Under a combined redirect (nohup ... > log 2>&1) stderr is unbuffered while
# stdout is block-buffered, so GABi's notes can surface far from the Snakemake
# lines they belong beside. Line buffering keeps a combined log readable. It
# changes nothing for `> out` alone, where the notes were already in order.
# Guarded: a stdout replaced by something without .reconfigure() (a test
# harness, an embedding host) must not take the run down with it.
try:
    sys.stdout.reconfigure(line_buffering=True)
except (AttributeError, ValueError, OSError):
    pass

# Minimum Snakemake version required by GABi
GABi_MIN_SNAKEMAKE = "9.27.0"
from snakemake import __version__ as _SMK_VERSION
from packaging.version import Version as _Version
if _Version(_SMK_VERSION) < _Version(GABi_MIN_SNAKEMAKE):
    sys.stderr.write(
        f"\n[GABi] ERROR: Snakemake version should be at least {GABi_MIN_SNAKEMAKE} "
        f"(you are using {_SMK_VERSION}).\n"
        f"[GABi] Please update the GABi_env, e.g. recreate it from the GABi folder with:\n"
        f"[GABi]   conda deactivate; conda env remove -n GABi_env; conda env create -f install.yml\n\n"
    )
    sys.exit(1)



# -------------------------------------------------------------------------------
# MAIN-PROCESS DETECTION
# -------------------------------------------------------------------------------
# Guards top-level prints (banners, logs) against re-execution in worker processes.
# IS_MAIN is True only in the parent process; workers skip noisy prints.
#
# note: Running Snakemake via srun/sbatch may suppress the banner (the pipeline
# still runs fine). To keep it, drop the SLURM_JOB_ID check below.

def is_main_process():
    """Return True if this is the main Snakemake process, not a worker."""
    # Cluster workers (SLURM injects SLURM_JOB_ID into every job);
    # Snakemake also sets its own job IDs in the worker environment.
    is_cluster_worker = any([
        os.environ.get("SNAKEMAKE_JOBID"),
        os.environ.get("SNAKEMAKE_SLURM_JOBID"),
        os.environ.get("SLURM_JOB_ID"),
    ])
    # Local workers (Snakemake re-invokes itself with `--mode subprocess`).
    is_local_worker = False
    for i, arg in enumerate(sys.argv):
        if arg == "--mode" and i + 1 < len(sys.argv) and sys.argv[i + 1] == "subprocess":
            is_local_worker = True
            break
    return not (is_cluster_worker or is_local_worker)


IS_MAIN = is_main_process()


