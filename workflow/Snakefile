# --- Read-path utilities ---
_READ_EXTS = (".fastq.gz", ".fq.gz", ".fastq", ".fq", ".gz")
# Separator for BAM file names
_SEP = "_"

# Mate-token handling, in three ordered steps, because a bcl2fastq chunk number
# has to survive while the mate marker must not:
#   1. ..._R1_001 -> ..._R_001    collapse the mate digit, KEEP the chunk
#   2. ..._1 / ...-R2 / ....R1 -> ...   drop a trailing mate marker
#   3. only when 1 and 2 found nothing, and only for a declared pair: drop the
#      single 1/2 that R2 confirms, wherever it sits (..._1_cov14x -> ..._cov14x).
#      Steps 1-2 are end-anchored and read R1 alone, so a marker in the middle
#      of a name survived into every output path for that library. See _pe_base().
#
# The separator in step 2 is deliberately NOT optional. When it was optional,
# any trailing digit was stripped: 'chr1' -> 'ch', 'sample_v2' -> 'sample_v',
# 'm84093_240101_112233_s1' -> '..._s', and - worse - the two chunks of one
# library ('..._R1_001' and '..._R1_002') both collapsed to '..._R1_00',
# leaking the mate marker into a base whose whole job is to name the library.
# A name with no separator before the marker (libAR1) is therefore left alone;
# NomNom's own pair detection would not have paired such files either.
_PAIR_CHUNK_RE = re.compile(r"([._-])R[12](_\d+)$", re.IGNORECASE)
_PAIR_TAIL_RE  = re.compile(r"[._-]R?[12]$", re.IGNORECASE)
# Word-style mate markers. NomNom pairs _F/_R, Forward/Reverse and Left/Right,
# so a declared pair may use them - but GABi never builds a base from them.
# Used ONLY to compare a declared R1 against its R2.
_PAIR_WORD_RE  = re.compile(r"[._-](?:F|R|fwd|rev|forward|reverse|left|right)$", re.IGNORECASE)
# Centralization prefix, e.g. 'Path2_'
_PATH_PREFIX_RE = re.compile(r"^Path\d+_")


def _strip_ext(p):
    """Remove common read file extensions"""
    bn = os.path.basename(p)
    for ext in _READ_EXTS:
        if bn.endswith(ext):
            return bn[:-len(ext)]
    return os.path.splitext(bn)[0]


def _strip_pair_token(bn):
    """Remove the mate marker from a basename, keeping any chunk number."""
    bn = _PAIR_CHUNK_RE.sub(r"\1R\2", bn)
    return _PAIR_TAIL_RE.sub("", bn)


def _read_stem(path, strip_mate=False, strip_prefix=False):
    """Comparable stem of a read path.

    strip_mate is OFF by default and must stay that way for long reads: a HiFi
    library legitimately called m64_run_1.fq.gz would otherwise lose its '_1',
    which is part of the library name, not a mate marker. No regex can tell
    those two apart - only the call site knows which it is looking at.
    """
    bn = _strip_ext(path)
    if strip_prefix:
        bn = _PATH_PREFIX_RE.sub("", bn)
    if strip_mate:
        bn = _strip_pair_token(bn)
        bn = _PAIR_WORD_RE.sub("", bn)
    return bn


def _mate_diff_index(a, b):
    """Position of the single 1/2 that distinguishes a declared R1/R2 pair.

    Returns the index into `a`, or None when the two basenames cannot be
    confirmed as mates from the names alone. Confirmation needs all of:
    same length, exactly one differing character, '1' in a against '2' in b,
    and that digit not part of a longer number. That covers every convention
    GABi sees ('x_1_cov14x', 'x_R1_001', 'x.1', 'x_1') and rejects the
    look-alikes: 'lib_11_x' vs 'lib_12_x' is two libraries, 's_cov14x' vs
    's_cov24x' is two coverages, 'L001_R1' vs 'L002_R2' differs twice.
    """
    if a == b or len(a) != len(b):
        return None
    idx = -1
    for i, (ca, cb) in enumerate(zip(a, b)):
        if ca == cb:
            continue
        if idx != -1:
            return None          # more than one difference
        idx = i
    if idx == -1 or a[idx] != "1" or b[idx] != "2":
        return None
    if idx and a[idx - 1].isdigit():
        return None
    if idx + 1 < len(a) and a[idx + 1].isdigit():
        return None
    return idx


def _mates_look_paired(r1, r2):
    """True when two declared read files look like R1/R2 of one library.

    Names only - it cannot see contents, so a genuinely mismatched pair that
    is named consistently still passes. Feeds a warning, never a rejection.
    Identical basenames in different directories (R1/lib.fq.gz, R2/lib.fq.gz)
    are a real convention and count as paired; the same file declared twice
    does not.
    """
    if r1 == r2:
        return False
    a, b = _strip_ext(r1), _strip_ext(r2)
    if _mate_diff_index(a, b) is not None:
        return True
    # Word-style markers (_F/_R, fwd/rev, left/right) and anything else the
    # end-anchored rules can strip: compare whatever is left of the two names.
    return _read_stem(r1, strip_mate=True) == _read_stem(r2, strip_mate=True)


def _pe_base(r1, r2):
    """Base name shared by a declared PE pair (step 3 above).

    Defers to _strip_pair_token() whenever that resolves something, so every
    name that already produced a base produces byte-identical output; the
    pair-confirmed cut only runs on names the end-anchored rules cannot see.
    An unconfirmed pair keeps R1's name, exactly as before - the cross-check
    warns about it rather than guessing.

    Note the deliberate asymmetry with _mates_look_paired(): the cross-check
    accepts any confirmed 1/2, because a quiet warning costs nothing, while
    the base only cuts a marker that is separated the way steps 1-2 require,
    because a changed base renames every output file for that library.
    """
    a = _strip_ext(r1)
    stripped = _strip_pair_token(a)
    if stripped != a:
        # `or a`: a file named literally '_1.fq.gz' strips to nothing, and an
        # empty base cannot satisfy the base=[^/]+ constraint on the B/D
        # outputs - it failed the DAG with an opaque message instead.
        return stripped or a
    i = _mate_diff_index(a, _strip_ext(r2))
    if i is None:
        return a
    left, right = a[:i], a[i + 1:]
    if left[-1:] in ("R", "r"):
        left = left[:-1]
    # Step 2's separator rule holds here too: 'libAR1' keeps its marker even
    # though R2 confirms it, so a name GABi would not have touched before is
    # not renamed now. Only '..._1', '...-1', '....1' and their R-prefixed
    # forms are cut.
    if left[-1:] not in (".", "_", "-"):
        return a
    left = left[:-1]
    # Degenerate input ('_1.fq.gz' / '_2.fq.gz') would leave nothing to name
    # the library after: keep R1's stem rather than emit an empty wildcard.
    return (left + right) or a

# Pairs already reported by the mate cross-check. _enumerate_groups() runs many
# times during DAG construction; the warning is worth seeing once.
_MATE_WARNED = set()

