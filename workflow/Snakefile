# --- URL / accession / path detection ---
def is_url(value: str) -> bool:
    """Check if value is a URL"""
    return isinstance(value, str) and (
        value.startswith(('http://', 'https://', 'ftp://', 'www.'))
    )

def is_sra_accession(value: str) -> bool:
    """Check if value is an SRA/ENA accession"""
    if not isinstance(value, str):
        return False
    # Match SRR/ERR/DRR followed by numbers
    return bool(re.match(r'^[SED]RR\d+$', value))

def is_ncbi_assembly_accession(value: str) -> bool:
    """Check if value is an NCBI assembly accession (GenBank or RefSeq)"""
    if not isinstance(value, str):
        return False
    import re
    # Match GCA_XXXXXXXXX.X or GCF_XXXXXXXXX.X
    return bool(re.match(r'^GC[AF]_\d{9}\.\d+$', value))

def is_existing_path(value: str) -> bool:
    """Check if value is an existing local path"""
    if not isinstance(value, str) or is_url(value) or is_sra_accession(value):
        return False
    return Path(value).exists()

def extract_filename_from_url(url: str) -> str:
    """Extract filename from URL"""
    parsed = urlparse(url)
    filename = Path(unquote(parsed.path)).name
    return filename if filename else "downloaded_file"

# --- Config value coercion ---
_TRUE_WORDS = {"1", "true", "t", "yes", "y", "on"}
_FALSE_WORDS = {"0", "false", "f", "no", "n", "off", ""}


def _as_bool(x, default=False):
    """Convert various true/false representations to boolean.

    Raises on anything else. Returning False for an unrecognised string meant
    a typo silently turned a flag off: 'TRIM_PE: maybe' read as "don't trim".

    Unquoted on/off/yes/no in the YAML are already real booleans by the time
    they arrive (PyYAML resolves YAML 1.1 booleans), so this matters for
    quoted values and for --config FLAG=off on the command line, where
    Snakemake keeps the string.
    """
    if isinstance(x, bool):
        return x
    if x is None:
        return default
    if isinstance(x, (int, float)):
        return bool(x)
    s = str(x).strip().lower()
    if s in _TRUE_WORDS:
        return True
    if s in _FALSE_WORDS:
        return False
    raise ValueError(
        f"[GABi] {x!r} is not a yes/no value. Use on/off (or true/false, yes/no)."
    )

# --- Read-type normalization ---
# read_type is free text: NomNom identifies the column but does not validate or
# map its values, so whatever the submitter typed reaches GABi verbatim. That
# makes this column the pipeline's weakest input, and a wrong guess is worse
# than a stop - so match against explicit alias sets and let
# validate_samples_config() reject anything unrecognised, once, at load.
#
# This replaced substring matching, which guessed: "pacbio" was in the HiFi
# term list, so 'pacbio_clr' silently became 'hifi' and received the ULI primer
# check and the SMRTbell adapter filter, neither meaningful for CLR data; and
# "pe"/"sr" as substrings matched inside unrelated words ('omni-c PE' ->
# 'omnicpe' -> illumina, before the Hi-C branch was ever reached).
_READ_TYPE_ALIASES = {
    "hifi": {
        "hifi", "hifireads", "pacbiohifi", "pacbiohifireads", "pbhifi",
        "ccs", "pacbioccs", "pbccs", "revio", "sequelii", "sequel2",
    },
    "ont": {
        "ont", "ontreads", "nanopore", "oxfordnanopore",
        "oxfordnanoporetechnologies", "minion", "promethion", "gridion",
        "ontr104", "ontr9", "ontr10",
    },
    "10x": {
        "10x", "10xgenomics", "10xchromium", "tenx", "chromium",
        "linked", "linkedreads",
    },
    "illumina": {
        "illumina", "illuminape", "shortreads", "shortread", "pairedend",
        "pe", "sr", "wgs",
    },
    # Hi-C normalises, but nothing downstream consumes it. Left exactly as it
    # was on purpose - see the NON_CALLABLE_TECHS note further down.
    "hic": {"hic", "arima", "omnic", "dovetail", "proximityligation"},
}

# Recognised spellings GABi deliberately does not process. Named separately so
# the error says what is wrong instead of only listing what is accepted.
_READ_TYPE_UNSUPPORTED = {
    "clr": "PacBio CLR", "pacbioclr": "PacBio CLR", "pbclr": "PacBio CLR",
    "iontorrent": "Ion Torrent", "sanger": "Sanger",
    "bgi": "BGI/DNBSEQ", "dnbseq": "BGI/DNBSEQ", "mgi": "BGI/DNBSEQ",
}

_RT_BY_ALIAS = {a: canon for canon, aliases in _READ_TYPE_ALIASES.items() for a in aliases}


def _canon_rt(read_type):
    """Fold a free-text read type to its comparison form: 'PacBio HiFi' -> 'pacbiohifi'."""
    return re.sub(r"[^a-z0-9]", "", str(read_type).lower())


def normalize_read_type(read_type):
    """
    Normalize read type to standard categories.
    Returns one of 'hifi', 'ont', '10x', 'illumina', 'hic', None for an empty
    value, or the lowercased original when unrecognised - which
    validate_samples_config() turns into an error before any job is scheduled.
    """
    if not read_type or read_type == "None":
        return None
    return _RT_BY_ALIAS.get(_canon_rt(read_type), str(read_type).lower())


def read_type_problem(read_type):
    """Why this read_type is not usable, or None if it is fine."""
    if not read_type or read_type == "None":
        return None
    canon = _canon_rt(read_type)
    if canon in _RT_BY_ALIAS:
        return None
    if canon in _READ_TYPE_UNSUPPORTED:
        return (f"{_READ_TYPE_UNSUPPORTED[canon]} data is not processed by GABi"
                if canon not in ("clr", "pacbioclr", "pbclr")
                else "PacBio CLR is not processed by GABi (HiFi/CCS reads only)")
    return "unrecognised read type"


def accepted_read_types():
    """Accepted spellings, grouped, for error messages."""
    return "\n".join(
        f"          {canon:9s} {', '.join(sorted(_READ_TYPE_ALIASES[canon]))}"
        for canon in ("hifi", "ont", "illumina", "10x", "hic")
    )

# --- Read-type predicates ---
def _is_long(rt):
    """Check if read type is long read (works with both raw and normalized types)"""
    rt_norm = normalize_read_type(rt)
    return rt_norm in {"hifi", "ont"}

def _is_short(rt):
    """Check if read type is short/paired-end read (works with both raw and normalized types)"""
    rt_norm = normalize_read_type(rt)
    return rt_norm in {"illumina", "10x"}

#def _is_pe(rt):
#    """Check if read type produces paired-end files"""
#    rt_norm = normalize_read_type(rt)
#    return rt_norm in {"illumina", "10x", "hic"}

def _is_10x(rt):
    """Check if read type is 10x linked reads"""
    rt_norm = normalize_read_type(rt)
    return rt_norm == "10x"

#def _is_hic(rt):
