# -------------------------------------------------------------------------------
# TEMP DIRECTORY LOGIC
# -------------------------------------------------------------------------------

# TEMP_DIR options:
#   "default" or "" -> OUT_FOLDER/GABi_results/tmp
#   "auto" -> detect from profile's apptainer-args, check space at runtime, fall back
#   "{path}" -> use that path
#
# FAST_TEMP_DIR options:
#   "default" or "" -> same as TEMP_DIR (shows hints for faster options)
#   "{path}" -> use that path

# --- Discovery functions ---
def _detect_ramfs_mounts():
    """Detect RAM-mounted filesystems"""
    mounts = []
    try:
        with open("/proc/mounts") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 3:
                    dev, mnt, fstype = parts[0], parts[1], parts[2]
                    if fstype in ("tmpfs", "ramfs", "hugetlbfs"):
                        try:
                            st = os.statvfs(mnt)
                            free_gb = st.f_bavail * st.f_frsize / (1024**3)
                        except:
                            free_gb = None
                        mounts.append((mnt, fstype, free_gb))
    except:
        pass
    return mounts

def _parse_fast_paths_from_profiles():
    """
    Parse apptainer-args from execution profiles to find fast temp paths.
    Returns a list of paths in priority order (localscratch > local > home).
    Appends /tmp to each path for organization.
    """
    profile_paths = [
        ROOT / "execution" / "slurm" / "profile.yaml",
        ROOT / "execution" / "local" / "profile.yaml",
    ]

    # Priority order: localscratch first, then local, then home
    fast_keywords_priority = [
        ("/localscratch", 1),
        ("/local/", 2),
        ("/home", 3),
    ]

    found_paths = []  # List of (priority, path)

    for profile_path in profile_paths:
        if not profile_path.exists():
            continue
        try:
            with open(profile_path) as f:
                profile_config = yaml.safe_load(f) or {}

            # Look for apptainer-args or singularity-args
            apptainer_args = profile_config.get("apptainer-args", "") or profile_config.get("singularity-args", "")

            if not apptainer_args:
                continue

            # Parse --bind arguments: --bind /path:/path or --bind /path
            bind_matches = re.findall(r'--bind\s+([^\s]+)', apptainer_args)

            for bind_arg in bind_matches:
                # Handle both /path:/path and /path formats
                source_path = bind_arg.split(":")[0]

                # Check if this path matches our fast keywords
                for keyword, priority in fast_keywords_priority:
                    if keyword in source_path:
                        # Add /tmp subdirectory for organization
                        tmp_path = os.path.join(source_path, "tmp")
                        # Avoid duplicates
                        if tmp_path not in [p[1] for p in found_paths]:
                            found_paths.append((priority, tmp_path))
                            if IS_MAIN: print(f"[GABi] Found fast temp candidate from profile: {tmp_path} (priority {priority})")
                        break

        except Exception as e:
            print(f"[GABi] Warning: Could not parse {profile_path}: {e}")
            continue

    # Sort by priority and return just the paths
    found_paths.sort(key=lambda x: x[0])
    return [p[1] for p in found_paths]

# Default fallback is always available
FALLBACK_TMP = os.path.join(config["OUT_FOLDER"], "GABi_results", "tmp")
os.makedirs(FALLBACK_TMP, exist_ok=True)

# --- Parse TEMP_DIR config ---
_temp_dir_raw = str(config.get("TEMP_DIR", "")).strip().lower()

if _temp_dir_raw in ("", "default"):
    TEMP_DIR = FALLBACK_TMP
    TEMP_DIR_CANDIDATES = [FALLBACK_TMP]
    if IS_MAIN: print(f"[GABi] TEMP_DIR -> {TEMP_DIR}")
elif _temp_dir_raw == "auto":
    # Try to detect from profile's apptainer-args
    detected_paths = _parse_fast_paths_from_profiles()
    if detected_paths:
        TEMP_DIR = detected_paths[0]  # Primary choice
        TEMP_DIR_CANDIDATES = detected_paths + [FALLBACK_TMP]  # All options including fallback
        if IS_MAIN: print(f"[GABi] TEMP_DIR -> {TEMP_DIR} (auto, with {len(detected_paths)} fast option(s))")
        if IS_MAIN: print(f"[GABi] Fallback chain: {' -> '.join(TEMP_DIR_CANDIDATES)}")
    else:
        TEMP_DIR = FALLBACK_TMP
        TEMP_DIR_CANDIDATES = [FALLBACK_TMP]
        if IS_MAIN: print(f"[GABi] TEMP_DIR -> {TEMP_DIR} (auto, no fast path detected in profiles)")
else:
    # User-specified path - also add /tmp subdirectory
    user_path = str(config.get("TEMP_DIR", "")).strip()
    if not user_path.endswith("/tmp"):
        TEMP_DIR = os.path.join(user_path, "tmp")
    else:
        TEMP_DIR = user_path
    TEMP_DIR_CANDIDATES = [TEMP_DIR, FALLBACK_TMP]
    if IS_MAIN: print(f"[GABi] TEMP_DIR -> {TEMP_DIR}")
# --- Parse FAST_TEMP_DIR config ---
_fast_temp_raw = str(config.get("FAST_TEMP_DIR", "")).strip().lower()

if _fast_temp_raw in ("", "default"):
    FAST_TEMP_DIR = TEMP_DIR  # Same as TEMP_DIR by default
    # Show hints about better options
    ram_options = _detect_ramfs_mounts()
    if ram_options:
        if IS_MAIN: print(f"[GABi] FAST_TEMP_DIR -> {FAST_TEMP_DIR}")
        if IS_MAIN: print(f"[GABi] ⚡ RAM-mounted filesystems detected - consider setting FAST_TEMP_DIR for faster I/O:")
        for mnt, typ, free_gb in ram_options:
            if free_gb is not None:
                if IS_MAIN: print(f"       - {mnt} [{typ}] ~{free_gb:.1f} GiB free")
            else:
                if IS_MAIN: print(f"       - {mnt} [{typ}]")
    else:
        if IS_MAIN: print(f"[GABi] FAST_TEMP_DIR -> {FAST_TEMP_DIR}")
else:
    # User-specified path - also add /tmp subdirectory
    user_fast_path = str(config.get("FAST_TEMP_DIR", "")).strip()
    if not user_fast_path.endswith("/tmp"):
        FAST_TEMP_DIR = os.path.join(user_fast_path, "tmp")
    else:
        FAST_TEMP_DIR = user_fast_path
    if IS_MAIN: print(f"[GABi] FAST_TEMP_DIR -> {FAST_TEMP_DIR}")
# Build the candidates list as a colon-separated string for shell
TEMP_CANDIDATES_STR = ":".join(TEMP_DIR_CANDIDATES)

# Export for every shell step (works inside Apptainer too)
# Include a helper function for runtime space checking with multiple fallbacks
shell.prefix(
    f"set -euo pipefail; "
    f"export TMPDIR='{TEMP_DIR}'; "
    f"export GABi_TMP='{TEMP_DIR}'; "
    f"export GABi_FAST_TMP='{FAST_TEMP_DIR}'; "
    f"export GABi_FALLBACK_TMP='{FALLBACK_TMP}'; "
    f"export GABi_TMP_CANDIDATES='{TEMP_CANDIDATES_STR}'; "
    # Function to get work dir with space check and multiple fallbacks
    """
gabi_get_workdir() {{
    local REQUIRED_GB="${{1:-100}}"
    local PENALTY_PER_JOB=50  # Subtract 50GB per existing GABi temp folder
    local FALLBACK="${{GABi_FALLBACK_TMP:-/tmp}}"

    echo "[GABi] Temp directory selection:" >&2
    echo "[GABi]   Required: ${{REQUIRED_GB}} GB (with ${{PENALTY_PER_JOB}} GB penalty per existing GABi job)" >&2

    # Parse candidates (colon-separated)
    IFS=':' read -ra CANDIDATES <<< "${{GABi_TMP_CANDIDATES:-$FALLBACK}}"

    for CANDIDATE in "${{CANDIDATES[@]}}"; do
        echo "[GABi]   Checking: $CANDIDATE" >&2

        # Check if directory exists or can be created
        if ! mkdir -p "$CANDIDATE" 2>/dev/null; then
            echo "[GABi]     Cannot create/access directory" >&2
            continue
        fi

        # Get available space
        AVAIL_KB=$(df -k "$CANDIDATE" 2>/dev/null | awk 'NR==2 {{print $4}}' || echo "0")
        AVAIL_GB=$((AVAIL_KB / 1024 / 1024))

        # Count existing GABi temp folders directly in this tmp directory
        EXISTING_JOBS=0
        if [ -d "$CANDIDATE" ]; then
            EXISTING_JOBS=$(find "$CANDIDATE" -maxdepth 1 -type d -name "GABi_*" 2>/dev/null | wc -l || echo "0")
        fi

        # Calculate adjusted available space
        PENALTY=$((EXISTING_JOBS * PENALTY_PER_JOB))
        ADJUSTED_GB=$((AVAIL_GB - PENALTY))

        echo "[GABi]     Raw available: ${{AVAIL_GB}} GB" >&2
        if [ "$EXISTING_JOBS" -gt 0 ]; then
            echo "[GABi]     Existing GABi jobs: $EXISTING_JOBS (penalty: -${{PENALTY}} GB)" >&2
            echo "[GABi]     Adjusted available: ${{ADJUSTED_GB}} GB" >&2
        fi

        # Check if adjusted space is sufficient
        if [ "${{ADJUSTED_GB:-0}}" -ge "$REQUIRED_GB" ] 2>/dev/null; then
            echo "[GABi] Using: $CANDIDATE (${{ADJUSTED_GB}} GB effective, ${{AVAIL_GB}} GB raw)" >&2
            echo "$CANDIDATE"
            return 0
        fi

        echo "[GABi]     ❌ Insufficient space (${{ADJUSTED_GB}} GB < ${{REQUIRED_GB}} GB required)" >&2
    done

    # All candidates exhausted, use fallback anyway with warning
    mkdir -p "$FALLBACK" 2>/dev/null || true
    FALLBACK_KB=$(df -k "$FALLBACK" 2>/dev/null | awk 'NR==2 {{print $4}}' || echo "0")
    FALLBACK_GB=$((FALLBACK_KB / 1024 / 1024))
    echo "[GABi] ⚠️  All fast options exhausted, using fallback: $FALLBACK (${{FALLBACK_GB}} GB free)" >&2
    echo "$FALLBACK"
}}
"""
)


