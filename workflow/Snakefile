# --- Sample data extraction ---

def get_assembly_path(species, assembly):
    return samples_config["sp_name"][species]["asm_id"][assembly]["asm_file"]

_NODE_LOOKUP_MISSES = set()
_NODE_LOOKUP_MISS_LIMIT = 5


def _report_node_lookup_miss(exc, species, assembly, sample_id, read_type_key):
    """Diagnostic for what _get_sample_node()'s blanket except is hiding."""
    key = (type(exc).__name__, species, assembly, sample_id, read_type_key)
    if key in _NODE_LOOKUP_MISSES:
        return
    _NODE_LOOKUP_MISSES.add(key)
    if not IS_MAIN or len(_NODE_LOOKUP_MISSES) > _NODE_LOOKUP_MISS_LIMIT:
        return
    if len(_NODE_LOOKUP_MISSES) == _NODE_LOOKUP_MISS_LIMIT:
        print("[GABi] NOTE: further config-lookup misses suppressed.")
        return
    print(
        f"[GABi] NOTE: config lookup found nothing for "
        f"{species}/{assembly}/{sample_id} ({read_type_key}) - "
        f"{type(exc).__name__}: {exc}"
    )


def _get_sample_node(species, assembly, sample_id, read_type_key=None):
    """Extract sample data from config"""
    try:
        node = samples_config["sp_name"][species]["asm_id"][assembly]["sample_id"][sample_id]

        if not node.get("read_type") or node["read_type"] == {"None": {}}:
            return None, False, {}

        # Simplified - just get reads, no trim_qc logic
        if read_type_key:
            target_norm = normalize_read_type(read_type_key)
            actual_key = None
            for yaml_key in node["read_type"]:
                if normalize_read_type(yaml_key) == target_norm:
                    actual_key = yaml_key
                    break

            if not actual_key:
                return None, False, {}

            sub = node["read_type"][actual_key]
            reads = sub.get("read_files", {}) or {}
            reads = {k: v for k, v in reads.items()
                    if v not in [None, "None"] and k.startswith("Path")}

            # Determine trim flag based on read type
            is_pe = target_norm in ["illumina", "10x"]
            is_hifi = target_norm == "hifi"

            if is_pe:
                trim = _as_bool(config.get("TRIM_PE", True))
            elif is_hifi:
                trim = _as_bool(config.get("FILTER_HIFI", True))
            else:
                trim = False

            return target_norm, trim, reads

        # Otherwise return first (for backward compatibility)
        rt = next(iter(node["read_type"]))
        if rt == "None" or rt is None:
            return None, False, {}

        sub = node["read_type"][rt]
        reads = sub.get("read_files", {}) or {}
        reads = {k: v for k, v in reads.items()
                if v not in [None, "None"] and k.startswith("Path")}

        rt_norm = normalize_read_type(rt)
        is_pe = rt_norm in ["illumina", "10x"]
        trim = _as_bool(config.get("TRIM_PE", True)) if is_pe else False

        return rt_norm, trim, reads

    except (KeyError, TypeError, AttributeError) as e:
        # Behaviour unchanged: absence is normal control flow here, several
        # callers probe with keys that may not exist, and they wrap this in
        # blanket excepts of their own. But the same except also swallows a
        # malformed YAML node (a None where a dict belongs), so it is worth
        # knowing whether it ever fires in a real run - and with what - before
        # narrowing it. Reported once per distinct cause, then suppressed.
        _report_node_lookup_miss(e, species, assembly, sample_id, read_type_key)
        return None, False, {}

def _normalize_pe(val, where=""):
    """Parse a paired-end read_files cell into exactly two paths.

    Splits on EVERY comma and checks parity. Splitting on the first comma only
    made a four-path cell yield r2 = "b.fq.gz, c.fq.gz, d.fq.gz" - a path that
    cannot exist, discovered when the job ran rather than when the DAG was
    built. A short cell is equally an error: GABi processes short reads as
    pairs, so a single-file illumina/10x entry is a mis-entered table, not
    single-end data.
    """
    if isinstance(val, list):
        parts = [str(x).strip() for x in val]
    else:
        parts = [x.strip() for x in str(val).split(",")]
    parts = [p for p in parts if p and p != "None"]

    if len(parts) != 2:
        loc = f"{where}: " if where else ""
        raise ValueError(
            f"[GABi] {loc}a paired-end entry must list exactly two files, "
            f"got {len(parts)}: {val!r}"
        )
    return parts[0], parts[1]

# --- Pre-aligned (BAM) input -------------------------------------------------
# GABi can be entered either from reads or from an already-aligned BAM. The
# technology stays declared in read_type (illumina / ont / hifi) exactly as for
# FASTQ - only the file extension says "mapping is already done". Nothing about
# the technology is inferred from the BAM; D02_import_bam reads its header purely
# to CHECK the declaration, the same way D06 cross-checks a declared karyotype
# against coverage.

def _is_bam_path(value):
    """True if a read_files value points at a single BAM."""
    if isinstance(value, list):
        return len(value) == 1 and str(value[0]).strip().lower().endswith(".bam")
    if not isinstance(value, str):
        return False
    v = value.strip()
    return "," not in v and v.lower().endswith(".bam")


def _read_paths(reads):
    """Flatten a read_files dict into individual paths."""
    out = []
    for v in (reads or {}).values():
        if isinstance(v, list):
            out.extend(str(x).strip() for x in v)
        elif isinstance(v, str):
            out.extend(x.strip() for x in v.split(","))
        else:
            out.append(str(v).strip())
    return [p for p in out if p]


def bam_entry_path(sp, asm, sid, rt_key):
    """The single pre-aligned BAM for this sample/read_type, or None.

    Raises when the declaration is one GABi cannot honour, rather than silently
    treating a half-BAM entry as reads.
    """
    _, _, reads = _get_sample_node(sp, asm, sid, rt_key)
    if not reads:
        return None
    paths = _read_paths(reads)
    bams = [p for p in paths if p.lower().endswith(".bam")]
    if not bams:
        return None
    if len(bams) != len(paths):
        raise ValueError(
            f"[GABi] {sid} ({rt_key}): read_files mixes BAM and FASTQ entries.\n"
            f"       A pre-aligned sample must provide exactly one BAM."
        )
    if len(bams) > 1:
        raise ValueError(
            f"[GABi] {sid} ({rt_key}): {len(bams)} BAMs provided.\n"
            f"       GABi expects exactly one BAM per sample - merge them first."
        )
    return bams[0]


def is_bam_entry(sp, asm, sid, rt_key):
    return bam_entry_path(sp, asm, sid, rt_key) is not None


def sample_is_bam_entry(sp, asm, sid):
    """True if this sample is entered as a pre-aligned BAM.

    A BAM sample must be BAM-only: mixing a FASTQ technology with a BAM
    technology would leave module B producing read QC for part of the sample,
    and a per-sample MultiQC report covering only some of its data.
    """
    try:
        sample_data = samples_config["sp_name"][sp]["asm_id"][asm]["sample_id"][sid]
        rt_keys = [k for k in sample_data.get("read_type", {}) if k not in ("None", None)]
    except (KeyError, TypeError, AttributeError):
        return False
    flags = [is_bam_entry(sp, asm, sid, k) for k in rt_keys]
    if any(flags) and not all(flags):
        mixed = ", ".join(k for k, f in zip(rt_keys, flags) if not f)
        raise ValueError(
            f"[GABi] {sid}: pre-aligned BAM input cannot be mixed with read input.\n"
            f"       This sample provides a BAM for one technology and reads for: {mixed}\n"
            f"       Use either reads or a BAM for the whole sample."
        )
    return bool(flags) and all(flags)


def _enumerate_groups(rt, reads_dict, ctx=""):
    """Generate read groups with consistent numbering.

    ctx is an optional "species/assembly/sample" string used only to locate a
    bad entry in an error message; DAG-time callers leave it empty.
    """
    if not reads_dict:
        return

    # Sort by Path number if possible
    def sort_key(k):
        if k.startswith("Path"):
            try:
                return int(k[4:])  # Extract number from "Path1", "Path2", etc.
            except ValueError:
                pass
        return k

    for key in sorted(reads_dict.keys(), key=sort_key):
        val = reads_dict[key]

        # idx comes from the Path key itself, never from a running counter.
        # Callers filter out None cells before getting here, so a missing
        # middle entry (NomNom writes None for a missing value) leaves a gap:
        # with a counter, Path3 would silently become 2 and every FASTQ,
        # report and BAM derived from it would change name.
        if not (key.startswith("Path") and key[4:].isdigit()):
            raise ValueError(
                f"[GABi] read_files key {key!r} is not of the form 'PathN'. "
                f"Read entries are numbered by their Path key, so it must be."
            )
        i = int(key[4:])

        # Pre-aligned input: a .bam in read_files means trimming and mapping
        # have already happened, so this entry has no read groups. Yielding
        # nothing is deliberate - _enumerate_groups feeds eight call sites
        # (four in B_trim_reads.smk), and every one of them should produce no
        # FASTQ-derived output for such a sample. The BAM itself is picked up by
        # bam_entry_path() and D02_import_bam instead.
        if _is_bam_path(val):
            continue

        if _is_long(rt):
            # Single/long read
            r = val if isinstance(val, str) else (val[0] if isinstance(val, list) else str(val))
            base = _strip_ext(r)
            yield {"idx": i, "rt": rt, "kind": "long", "r": r, "base": base}
        else:
            # Paired-end read
            # No try/except here on purpose. It used to downgrade a bad PE
            # entry to print("Warning: ...") + continue, which produced a read
            # group that silently vanished: no output, no error, a sample
            # quietly smaller than the table says.
            where = f"{ctx}/{rt}/{key}" if ctx else f"{rt}/{key}"
            r1, r2 = _normalize_pe(val, where=where)
            base = _pe_base(r1, r2)

            # Name-based mate cross-check. Without it R2's name is never
            # looked at and a row pairing sampleA_1.fq.gz with
            # sampleB_2.fq.gz is accepted, processed, and produces a
            # plausible-looking result.
            # It warns rather than raises: naming schemes exist that these
            # rules cannot parse, and a hard failure would block valid
            # data. It compares names, not contents - a genuinely
            # mismatched pair that is named consistently still passes.
            if not _mates_look_paired(r1, r2) and (r1, r2) not in _MATE_WARNED:
                _MATE_WARNED.add((r1, r2))
                if IS_MAIN:
                    s1 = _read_stem(r1, strip_mate=True)
                    s2 = _read_stem(r2, strip_mate=True)
                    print(
                        f"[GABi] WARNING: {where}: R1 and R2 do not look like mates.\n"
                        f"        R1: {r1}\n"
                        f"        R2: {r2}\n"
                        f"        stems: {s1!r} vs {s2!r}\n"
                        f"        Check the read_files cell - the files are used as declared."
                    )

            yield {"idx": i, "rt": rt, "kind": "pe", "r1": r1, "r2": r2, "base": base}


# samples_config does not change after load, and _collect_sample_reads() is
# called from input functions for every job during DAG construction. It used
# to stop at the first assembly containing the sample; now it always walks the
# whole config, so without this the cost grows with the number of assemblies
# on every call.
_SAMPLE_READS_CACHE = {}


def _collect_sample_reads(sample_id, read_type_key=None):
    """Read entries for a sample, collected across EVERY assembly it appears in.

    Returns {normalized_read_type: reads_dict}, or the single entry matching
    read_type_key when one is given.

    The whole point of the sample_id column is that one sample recurs across
    assemblies - that is what makes the layout sample-centric, and why module B
    processes a sample's reads once. Taking the first (species, assembly) node
    that happened to contain the sample meant that when two rows for the same
    sample_id AND read_type carried different read_files, one silently won, and
    which one depended on dict iteration order.

    Same sample + same technology + different files is a config error and is
    raised, naming both assemblies. A sample declaring DIFFERENT technologies
    under different assemblies is legitimate and is collected normally.
    """
    target = normalize_read_type(read_type_key) if read_type_key else None
    cache_key = (sample_id, target)
    cached = _SAMPLE_READS_CACHE.get(cache_key)
    if cached is not None:
        return cached

    found = {}      # rt_norm -> reads_dict
    origin = {}     # rt_norm -> "species/assembly" that first declared it

    for sp_name, sp_data in (samples_config.get("sp_name") or {}).items():
        if not sp_data or "asm_id" not in sp_data:
            continue
        for asm_id, asm_data in (sp_data["asm_id"] or {}).items():
            if not asm_data or "sample_id" not in asm_data:
                continue
            if sample_id not in (asm_data["sample_id"] or {}):
                continue
            node = asm_data["sample_id"][sample_id]
            if not node or not node.get("read_type"):
                continue

            for yaml_key, sub in node["read_type"].items():
                if yaml_key in (None, "None") or not sub:
                    continue
                rt_norm = normalize_read_type(yaml_key)
                if rt_norm is None or (target is not None and rt_norm != target):
                    continue

                reads = sub.get("read_files", {}) or {}
                reads = {k: v for k, v in reads.items()
                         if v not in [None, "None"] and k.startswith("Path")}
                if not reads:
                    continue

                here = f"{sp_name}/{asm_id}"
                if rt_norm in found and found[rt_norm] != reads:
                    raise ValueError(
                        f"[GABi] {sample_id} ({rt_norm}): the same sample and technology "
                        f"declares different read_files under two assemblies.\n"
                        f"       {origin[rt_norm]}: {found[rt_norm]}\n"
                        f"       {here}: {reads}\n"
                        f"       GABi processes a sample's reads once, so the two rows "
                        f"must agree."
                    )
                found.setdefault(rt_norm, reads)
                origin.setdefault(rt_norm, here)

    # Only successful walks are cached; a divergent table raises every time.
    _SAMPLE_READS_CACHE[cache_key] = found
    return found


# Suffixes GABi appends to mark its own processed files. Module B's link and
# compress rules exclude them from the `base` wildcard, so a SOURCE file whose
# name already ends in one cannot be bound by any producer - the run dies with
# a MissingInputException that says nothing about the cause.
#   long reads: B00/B01_link/compress_long_reads, B03, B05, B07
#   paired end: B00/B01_link/compress_pe_reads (B02, the trimming path, does
#               not constrain base, so a *_trimmed_R1.fq.gz source is only a
#               problem when TRIM_PE is off)
_RESERVED_BASE_SUFFIXES = {
    "long": ("_corrected", "_filtered"),
    "pe": ("_trimmed",),
}


# Every flag the code reads as a yes/no. Checked once at load so a typo is
# reported next to the table's own problems instead of quietly meaning "off".
# JOINT_GENO is deliberately absent: it is off/merge/multi, not a flag.
_BOOL_FLAGS = (
    "CORRECT_ONT",
    "DEDUP_LONG",
    "DEDUP_PE",
    "FILTER_HIFI",
    "KEEP_RAW_BCF",
    "KEEP_RAW_JOINT",
    "KEEP_gVCF",
    "READS_MAPPING",
    "RUN_CALLING",
    "RUN_COMPL",
    "RUN_PSMC",
    "RUN_ROCO",
    "RUN_TAGGING",
    "TRIM_PE",
)


def validate_samples_config():
    """Check the whole table once, before anything is scheduled.

    Every problem here used to surface later and further away: an unrecognised
    read type as a MissingInputException on a directory no rule can build, a
    mis-entered read_files cell as a job failing on a path that cannot exist,
    or - worse - as nothing at all. Collect them and report them together, so
    one pass over the table fixes them all.
    """
    problems = []
    bad_read_types = []

    for flag in _BOOL_FLAGS:
        if flag not in config:
            continue
        value = config[flag]
        if value is None:
            # 'TRIM_PE:' with nothing after it. config.get() returns None
            # because the key exists, so the default in the call site never
            # applies and the flag reads as off - the opposite of TRIM_PE's
            # documented default. Ask rather than guess.
            problems.append(
                f"  {flag}: has no value. An empty setting reads as 'off', "
                f"which is rarely what was meant - write on or off."
            )
            continue
        try:
            _as_bool(value)
        except ValueError as e:
            problems.append(f"  {flag}: {str(e).replace('[GABi] ', '')}")

    for sp_name, sp_data in (samples_config.get("sp_name") or {}).items():
        if not sp_data or "asm_id" not in sp_data:
            continue
        for asm_id, asm_data in (sp_data["asm_id"] or {}).items():
            if not asm_data or "sample_id" not in asm_data:
                continue
            for sid, node in (asm_data["sample_id"] or {}).items():
                if not node or not node.get("read_type"):
                    continue
                for yaml_key, sub in node["read_type"].items():
                    if yaml_key in (None, "None") or not sub:
                        continue
                    ctx = f"{sp_name}/{asm_id}/{sid}"

                    why = read_type_problem(yaml_key)
                    if why:
                        problems.append(
                            f"  {ctx}: read_type {yaml_key!r} - {why}"
                        )
                        bad_read_types.append(yaml_key)
                        continue

                    reads = sub.get("read_files", {}) or {}
                    reads = {k: v for k, v in reads.items()
                             if v not in [None, "None"] and k.startswith("Path")}
                    try:
                        groups = list(_enumerate_groups(
                            normalize_read_type(yaml_key), reads, ctx=ctx))
                    except ValueError as e:
                        problems.append("  " + str(e).replace("[GABi] ", "").replace("\n", "\n  "))
                        continue

                    for grp in groups:
                        reserved = [
                            sfx for sfx in _RESERVED_BASE_SUFFIXES.get(grp["kind"], ())
                            if grp["base"].endswith(sfx)
                        ]
                        if not reserved:
                            continue
                        if grp["kind"] == "pe" and _as_bool(config.get("TRIM_PE", True)):
                            # B02 takes it; only the link/compress path refuses.
                            continue
                        src = grp.get("r") or grp.get("r1")
                        problems.append(
                            f"  {ctx}/Path{grp['idx']}: {os.path.basename(src)} ends in "
                            f"{reserved[0]!r}, which GABi reserves for the files it "
                            f"produces itself.\n"
                            f"       No rule can take a source file with that suffix. "
                            f"Rename it (or symlink it under another name)."
                        )

    # Divergence between assemblies, checked once per sample.
    seen = set()
    for sp_data in (samples_config.get("sp_name") or {}).values():
        if not sp_data or "asm_id" not in sp_data:
            continue
        for asm_data in (sp_data["asm_id"] or {}).values():
            if not asm_data or "sample_id" not in asm_data:
                continue
            for sid in (asm_data["sample_id"] or {}):
                if sid in seen or sid in (None, "None"):
                    continue
                seen.add(sid)
                try:
                    _collect_sample_reads(sid)
                except ValueError as e:
                    problems.append("  " + str(e).replace("[GABi] ", "").replace("\n", "\n  "))

    if problems:
        message = ("(U ಥ ﻌ ಥ)  GABi cannot run with this data table:\n\n"
                   + "\n".join(problems))
        if bad_read_types:
            message += ("\n\n       Accepted read_type spellings "
                        "(case, spaces, - and _ are ignored):\n"
                        + accepted_read_types())
        raise ValueError(message)

    if IS_MAIN:
        print(f"[GABi] Data table validated: {len(seen)} sample(s)")


# Reported the way validate_sex_config() reports: a config error is the user's
# to fix, not a traceback to read.
try:
    validate_samples_config()
except ValueError as _e:
    print(str(_e))
    sys.exit(1)

# --- Technology helpers (single source of truth) ---
# These live here rather than in D_map_reads.smk / E_variant_call.smk because
# both modules need them, and `include:` happens after this point so every rule
# file sees them. D and E previously each carried their own copy of the priority
# logic, with a comment in D06 asking that the two be kept in sync by hand.

# Read technologies that are never mapped and never used for variant calling.
# Hi-C is assembly/scaffolding data: normalize_read_type() recognises it, but no
# mapping rule accepts it (D02_map_pe_reads is constrained to illumina|10x and
# D02_map_long_reads to hifi|ont), so it has to be filtered out before it can
# reach the DAG.
# NOT APPLIED YET - callable_techs() is unused until the selection phase.
NON_CALLABLE_TECHS = {"hic"}

# Which read technologies each variant caller can be used with.
#   deep - DeepVariant: WGS / PACBIO / ONT_R104 models cover every tech
#   bcft - bcftools:    mpileup has an -X profile for every tech we support
#   gatk - HaplotypeCaller: short reads, plus HiFi (discouraged). Never ONT.
# NOT APPLIED YET - consumed by the validation gate and selection phases.
CALLER_TECHS = {
    "deep": {"illumina", "10x", "hifi", "ont"},
    "bcft": {"illumina", "10x", "hifi", "ont"},
    "gatk": {"illumina", "10x", "hifi"},
}

# Accepted CALLER spellings -> canonical key. The input is lowercased first, so
# a single entry covers every capitalisation ("deepvariant" also matches
# "DeepVariant", "Deepvariant", "DEEPVARIANT", ...).
# NOT APPLIED YET - normalize_caller() is unused until the config phase.
_CALLER_ALIASES = {
    "deep": "deep", "deepvariant": "deep", "dv": "deep",
    "bcft": "bcft", "bcftools": "bcft", "bcf": "bcft",
    "gatk": "gatk", "haplotypecaller": "gatk", "hc": "gatk",
}


def normalize_caller(value, default="deep"):
    """Map a CALLER config value onto its canonical key: deep / bcft / gatk."""
    raw = str(value if value is not None else default).strip().lower()
    if raw not in _CALLER_ALIASES:
        raise ValueError(
            f"[GABi] Invalid CALLER: {value!r}. Accepted values are (case-insensitive): "
            f"{', '.join(sorted(set(_CALLER_ALIASES)))}"
        )
    return _CALLER_ALIASES[raw]


def priority_list():
    """DATA_PRIORITY parsed into an ordered list of normalized tech names."""
    raw = str(config.get("DATA_PRIORITY", "hifi>illumina>ont"))
    return [x.strip().lower() for x in re.split(r"[>\s,]+", raw) if x.strip()]


def sample_techs(sp, asm, sid):
    """Normalized read types that actually have read files for this sample.

    Raw enumeration: does NOT filter NON_CALLABLE_TECHS. Use callable_techs()
    for anything that feeds mapping, tech selection or variant calling.
    """
    try:
        sample_data = samples_config["sp_name"][sp]["asm_id"][asm]["sample_id"][sid]
        techs = []
        for rt_key in sample_data.get("read_type", {}):
            if rt_key in ("None", None):
                continue
            rt_norm = normalize_read_type(rt_key)
            _, _, reads = _get_sample_node(sp, asm, sid, rt_key)
            if reads:
                techs.append(rt_norm)
        return techs
    except (KeyError, TypeError, AttributeError):
        return []


def callable_techs(sp, asm, sid, caller=None):
    """sample_techs() minus non-callable techs, and minus techs the given
    caller cannot handle. Order follows the data table, not DATA_PRIORITY."""
    techs = [t for t in sample_techs(sp, asm, sid) if t not in NON_CALLABLE_TECHS]
    if caller is not None:
        allowed = CALLER_TECHS[normalize_caller(caller)]
        techs = [t for t in techs if t in allowed]
    return techs


def parse_joint_geno(value):
    """JOINT_GENO -> 'off' | 'merge' | 'multi'.

    Lives here, next to normalize_caller(), because BOTH the Snakefile's output
    collector and E_variant_call.smk have to agree on what the setting means.
    They previously did not: the collector tested it with _as_bool(), which only
    recognises on/true/yes/1, so 'merge' and 'multi' evaluated to False and no
    joint outputs were ever requested - while E happily reported joint
    genotyping as enabled. Nothing failed; the files simply never appeared.

    YAML turns an unquoted off/on into False/True, so both forms are handled.
    'on' remains a silent alias for 'merge'. 'true'/'yes' cannot be distinct
    values for the same reason - YAML would collapse them into booleans.
    """
    if value is None or value is False:
        return "off"
    if value is True:
        return "merge"
    s = str(value).strip().lower()
    aliases = {
        "off": "off", "false": "off", "no": "off", "0": "off", "none": "off",
        "merge": "merge", "on": "merge", "true": "merge", "yes": "merge", "1": "merge",
        "multi": "multi",
    }
    if s not in aliases:
        raise ValueError(
            f"[GABi] Invalid JOINT_GENO: {value!r}. Expected one of:\n"
            f"       off   - no joint genotyping\n"
            f"       merge - combine the per-sample gVCFs (alias: on)\n"
            f"       multi - call the whole cohort together from BAMs "
            f"(CALLER: bcft only)"
        )
    return aliases[s]


def joint_geno_mode():
    """Configured JOINT_GENO mode, parsed. Use this, never _as_bool().

    parse_joint_geno() takes the RAW value: it is a three-way setting
    (off/merge/multi), so passing it through _as_bool() first would collapse
    'merge' and 'multi' to False - the exact bug parse_joint_geno() was
    written to fix.
    """
    return parse_joint_geno(config.get("JOINT_GENO", False))


def caller_eligible_techs():
    """Technologies the configured CALLER can use, sorted.

    Lives here rather than in E_variant_call.smk because D_map_reads.smk needs
    it too (to tell the selection script which technologies are candidates) and
    D is included first, so E's _CALLER is not yet defined when D is parsed.
    """
    return sorted(CALLER_TECHS[normalize_caller(config.get("CALLER", "deep"))])


def pick_priority_tech(sp, asm, sid, techs=None):
    """Highest-priority tech for a sample according to DATA_PRIORITY.

    Coverage is NOT consulted - this is DAG-time ordering only. Returns None
    when the sample has no usable reads. Falls back to the first available
    tech when none of them appear in DATA_PRIORITY.
    """
    if techs is None:
        techs = sample_techs(sp, asm, sid)
    if not techs:
        return None
    if len(techs) == 1:
        return techs[0]
    for prio in priority_list():
        if prio in techs:
            return prio
    return techs[0]


# --- Output path generation ---
#def _reads_outdir(sp, asm, sid):
#    """Get reads output directory"""
#    return os.path.join(config["OUT_FOLDER"], "GABi_results", sp, asm, "samples", str(sid), "reads")
#
#def _reads_reportdir(sp, asm, sid):
#    """Get reports output directory"""
#    return os.path.join(_reads_outdir(sp, asm, sid), "reports")

def _outputs_for_group(sp, asm, sid, grp, trim):
    """Generate output filenames for a read group (sample-centric)"""
    data_base = os.path.join(config["OUT_FOLDER"], "GABi_results", "data")
    rt = grp["rt"]
    i  = grp["idx"]
    base = grp["base"]

    if grp["kind"] == "long":
        if rt == "hifi" and _as_bool(config.get("FILTER_HIFI", True)):
            name = f"Path{i}_{base}_filtered.fq.gz"
            return [os.path.join(data_base, sid, rt, "processed", name)]
        elif rt == "ont" and _as_bool(config.get("CORRECT_ONT", False)):
            name = f"Path{i}_{base}_corrected.fq.gz"
            return [os.path.join(data_base, sid, rt, "processed", name)]
        else:
            name = f"Path{i}_{base}.fq.gz"
            return [os.path.join(data_base, sid, rt, name)]
    else:
        if trim:
            subdir = os.path.join(data_base, sid, rt, "processed")
            r1 = os.path.join(subdir, f"Path{i}_{base}_R1_trimmed.fq.gz")
            r2 = os.path.join(subdir, f"Path{i}_{base}_R2_trimmed.fq.gz")
        else:
            subdir = os.path.join(data_base, sid, rt)
            r1 = os.path.join(subdir, f"Path{i}_{base}_R1.fq.gz")
            r2 = os.path.join(subdir, f"Path{i}_{base}_R2.fq.gz")
        return [r1, r2]

